<% layout("/layouts/boilerplate")%> 

<style>
#filters{
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.filter{
  text-align: center;
  margin-right: 2rem;
  margin-top: 2rem;
  opacity: 0.7;
}

.filter:hover{
  opacity: 1;
  cursor: pointer;
}

.tax-info{
  display: none;
}

.category {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 1rem 0;
}

.category a {
    text-decoration: none;
    color: #717171;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 70px;
}

.category a i {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
}

.category a p {
    margin: 0;
    font-size: 0.9rem;
}
.category-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
}
.category a:hover {
    color: #222;
}

.tax-toggle {
    border: 1px solid #222;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    margin-left: 2rem;
    white-space: nowrap;
    flex-shrink: 0;
}
</style>

<div class="category-container">

    <div class="category">

        <a href="/listings?category=Trending">
            <i class="fa-solid fa-fire"></i>
            <p>Trending</p>
        </a>

        <a href="/listings?category=Room">
            <i class="fa-solid fa-bed"></i>
            <p>Room</p>
        </a>

        <a href="/listings?category=Iconic%20cities">
            <i class="fa-solid fa-city"></i>
            <p>Iconic cities</p>
        </a>

        <a href="/listings?category=Mountains">
            <i class="fa-solid fa-mountain"></i>
            <p>Mountains</p>
        </a>

        <a href="/listings?category=Castles">
            <i class="fa-solid fa-chess-rook"></i>
            <p>Castles</p>
        </a>

        <a href="/listings?category=Amazing%20Pools">
            <i class="fa-solid fa-person-swimming"></i>
            <p>Amazing Pools</p>
        </a>

        <a href="/listings?category=Camping">
            <i class="fa-solid fa-campground"></i>
            <p>Camping</p>
        </a>

        <a href="/listings?category=Farms">
            <i class="fa-solid fa-cow"></i>
            <p>Farms</p>
        </a>

        <a href="/listings?category=Arctic">
            <i class="fa-solid fa-snowflake"></i>
            <p>Arctic</p>
        </a>

        <a href="/listings?category=Domes">
            <i class="fa-solid fa-igloo"></i>
            <p>Domes</p>
        </a>

    </div>

    <div class="tax-toggle">

        <div class="form-check-reverse form-switch">

            <input
                class="form-check-input"
                type="checkbox"
                role="switch"
                id="switchCheckDefault"
            >

            <label
                class="form-check-label"
                for="switchCheckDefault"
            >
                Display total after taxes
            </label>

        </div>

    </div>

</div>


  
  <div class="row row-cols-lg-6 row-cols-md-2 row-cols-sm-1 mt-3 listing_cards row-cols-1">
  <% for(let listing of allListings){ %>
    <a href="/listings/<%=listing._id%>" class="listing-link">

      <div class="card col listing-card">
  <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 11rem;">
    <div class="card-img-overlay"></div>
  <div class="card-body">
    <p class="card-text">
    <b> <%= listing.title %></b> <br>
   &#8377 <%= listing.price.toLocaleString("en-IN") %> / night
   <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
  </div>
</div>
</a>
<% } %>
</div>

<script>
  let taxSwitch =document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", ()=>{
    let taxInfo = document.getElementsByClassName("tax-info");
    for(info of taxInfo){
      if(info.style.display != "inline"){
      info.style.display = "inline";
      } else{
        info.style.display = "none";
      }
    }
  });
  </script>